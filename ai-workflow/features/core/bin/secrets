#!/usr/bin/env python3
"""Checks secrets without ever printing them: whether a variable is set in the environment or in an
env file, which variables a file defines, and, for piping only, a value. Run `secrets --help`."""
import argparse
import fnmatch
import functools
import glob
import json
import os
import re
import sys

CONFIG_VAR = "SECRETS_CONFIG"
# The excluded files ship placeholders, which would say "set" for a name nobody has configured.
# Names are matched as globs on the whole variable name, so KEY and PASS are spelled as whole `_`-separated
# words: MONKEY, KEYBOARD_LAYOUT, PASSENGER and the like aren't secrets, and redacting their values
# everywhere would only garble output. SSH_AUTH_SOCK, GIT_AUTHOR_NAME and PWD have no word here for the same
# reason. A secret-looking name can still hold config (TOKEN_TTL=3600, or GOOGLE_APPLICATION_CREDENTIALS, a
# path by convention): the excluded names and the minimum length keep those values, which would be replaced
# in every output, out.
DEFAULT_CONFIG = {
    "files": {
        "include": [".env", ".env.*", ".secrets"],
        "exclude": ["*.example", "*.sample", "*.template", "*.dist", "*.defaults"],
    },
    "redact": {
        "names": [
            "*SECRET*", "*TOKEN*", "*PASSWORD*", "*PASSWD*", "*PASSPHRASE*", "*CREDENTIAL*", "*APIKEY*",
            "KEY", "KEY_*", "*_KEY", "*_KEY_*", "PASS", "PASS_*", "*_PASS", "*_PASS_*",
        ],
        "excludeNames": ["*_PATH", "*_FILE", "*_DIR", "*_TTL", "*_LENGTH", "*_PREFIX", "GOOGLE_APPLICATION_CREDENTIALS"],
        "minLength": 6,
        "urlPasswords": True,
    },
}
# By context, not by value: a dev password like "postgres" is also the scheme and the user of its own URL,
# and redacting every occurrence of the value would garble the rest of the URL along with it. Anchored on
# `://` (or JSON's `:\/\/`), not on the scheme, so a URL glued to the text before it (`\033[1mpostgres://`)
# matches too, and no attempt runs past the next `/` or space (linear on any output). The password runs to
# the last `@` before the first `/`, so a literal `@` in it doesn't end it. A `/` in a password has to be
# percent-encoded, as it does for any URL a client can use, and so does an `@` in the user.
URL_PASSWORD = re.compile(r":\\?/\\?/[^\s/:@]*:([^\s/]+)@")
# Letters-only or digits-only values under this length ("postgres", "changeme", "123456") are ordinary words
# or numbers elsewhere; they are redacted only right after their own variable name.
WEAK_VALUE = re.compile(r"[A-Za-z]+|[0-9]+")
WEAK_MAX_LENGTH = 16
WEAK_CONTEXT = re.compile(rf"""[=:]\s*["']?([A-Za-z]{{1,{WEAK_MAX_LENGTH - 1}}}|[0-9]{{1,{WEAK_MAX_LENGTH - 1}}})(?![A-Za-z0-9])""")
WORD_CHAR = re.compile(r"[A-Za-z0-9_]")
# A line of a multi-line value is also searched on its own only when it looks like key material, and a line
# with spaces only by its long words (a JSON credential's `"private_key": "-----BEGIN...\n...",`): marker
# lines (`-----BEGIN PRIVATE KEY-----`), URLs, email addresses and the other lines of a JSON credential
# (`"type": "service_account",`) are ordinary text in other files.
KEY_BODY_LINE = re.compile(r"(?!-----)\S{16,}")
KEY_WORD_MIN_LENGTH = 32
# `$OTHER` or `${OTHER}` and nothing else: in an env file, a reference to another variable, not a value.
# A bare `$` name has to be env-var style, so a literal like `$ecretPassw0rd` stays a value.
REFERENCE = re.compile(r"\$(?:[A-Z_][A-Z0-9_]*|\{[A-Za-z_][A-Za-z0-9_]*\})")
# A PEM body is at most ~100 lines.
PEM_MAX_LINES = 200
# Where a PEM block that never ends gives up: base64 lines never have an `=` before their last characters.
ENV_LINE = re.compile(r"\s*(?:export\s+)?[A-Z_][A-Z0-9_]{0,62}=[^=]")
# A `#` after whitespace starts a comment; a lookbehind, as `\s+#` would rescan a run of spaces from each one.
COMMENT = re.compile(r"(?<=\s)#")
# A commented-out assignment isn't a variable, but its value is still a secret. `=` right after the name, so
# prose (`# Set API_KEY to your key`, `# API_KEY = the dashboard's key`) isn't one.
COMMENTED_ASSIGNMENT = re.compile(r"\s*#+\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]{0,62})=(.*)")
# A commented-out value of one of these shapes is an example, not an old secret: redacting it would garble the
# code that uses the same placeholder (`os.getenv("API_KEY", "your-api-key-here")`). Kept narrow on purpose.
PLACEHOLDER = re.compile(r"<.*>|(?i:your[-_]).*|[xX*.-]{3,}|changeme")
# Read from its own line, a commented-out PEM block is its BEGIN marker, which every key has.
PEM_MARKER = re.compile(r"-----BEGIN[A-Z0-9 ]*(?:-----)?")
PADDING = re.compile(r"=*\s*")
REDACT_FILES_VAR = "SECRETS_REDACT_FILES"
# An env file is small. The caps keep a repository's large files (or symlinks to them) from pushing `redact`
# past the plugin's timeout, after which results are stored unredacted, or into gigabytes of memory.
MAX_FILE_BYTES = 1 << 20
MAX_REDACT_BYTES = 4 << 20
# Each value is one scan of the text, so their number bounds the time `redact` takes.
MAX_SEARCH_VALUES = 10_000
MAX_ENV_FILES = 50

DESCRIPTION = """\
Checks secrets without printing them, so an agent never has to read one into its context.

  secrets has NAME...        is each NAME set, and where?
  secrets list               the names defined, grouped by source, no values
  secrets get NAME           the value, for piping into another command only

has, list and get look at the same sources. By default: the current environment and the env files of the
current directory that exist (see Configuration: by default .env, .env.* such as .env.local and
.env.development.local, and .secrets; placeholders like .env.example are skipped; at most 50 files). Narrow it
with --env (only the current environment) and/or --file PATH (only those files; repeatable, any path).
"""

EXAMPLE_CONFIG = f"""\
{{
  "files": {{
    "include": {json.dumps(DEFAULT_CONFIG["files"]["include"])},
    "exclude": {json.dumps(DEFAULT_CONFIG["files"]["exclude"])}
  }},
  "redact": {{
    "names": {json.dumps(DEFAULT_CONFIG["redact"]["names"])},
    "excludeNames": {json.dumps(DEFAULT_CONFIG["redact"]["excludeNames"])},
    "minLength": {DEFAULT_CONFIG["redact"]["minLength"]},
    "urlPasswords": {json.dumps(DEFAULT_CONFIG["redact"]["urlPasswords"])}
  }}
}}"""

EPILOG = """\
`has` prints one line per NAME, saying where it is set (`API_KEY: set in env, .env`) or where it looked
(`API_KEY: not set (checked env, .env, .env.local)`); a variable with no value counts as not set and is
mentioned as `empty in <source>`. It never prints values or their lengths, and exits 0 only if every NAME is
set in at least one source, 1 otherwise. Use it before concluding a secret is missing; don't `echo`,
`printenv`, `cat` or `grep` env files to find out. `env` is the current environment; the rest are files.

`list` prints one markdown section per source, `## env` or `## <file>`, with the names it defines, so each
name shows where it comes from (the same name appears under every source that defines it):

  ## env
  - HOME
  ## .env
  - API_KEY
  - PORT

An explicit --file that can't be read is reported in its section (`list`) or after the names (`has`) and
exits 1.

`get` is for the rare case a value has to reach another program. Never run it bare: its output ends up in
your context. Feed it straight into the consumer, so it never reaches your output:

  secrets get API_KEY --file .env.prod | gh secret set API_KEY
  API_KEY="$(secrets get API_KEY)" ./deploy.sh
  curl -H "Authorization: Bearer $(secrets get API_KEY)" "$URL"

It prints only the value, with no trailing newline (so a pipe carries exactly the value; a terminal gets one).
It exits 1 with a message on stderr if the variable is missing or empty in every source, or if sources disagree:
when NAME has different values in several, it picks none; say which with --env or --file PATH. Don't put the
value in a command's arguments you then print, or in a file you then read.

Env files: `NAME=value` lines, optionally `export `-prefixed; `#` comments (and ` #` after an unquoted
value, so `NAME= # note` is empty while `NAME=#x` is `#x`); single or double quoted values, which may span
lines (double quotes understand \\n, \\t, \\", \\\\). Other lines are ignored (a direnv `.envrc` isn't read by default: its values are often shell expressions such as `$(...)`; add it to files.include if yours are plain).
`${OTHER}` references are not expanded. When a name appears twice, the last assignment wins, as in a shell.
A line with nothing (or only `=`) after `NAME=` is a variable only if NAME isn't in mixed case (FOO=, foo_bar=):
a base64 key file (a Fernet or WireGuard key) would read as one. A file over 1 MiB is an error.

Configuration: an optional JSON file, $SECRETS_CONFIG if set (it must exist), else
$XDG_CONFIG_HOME/secrets-cli/config.json (~/.config/secrets-cli/config.json); without one, the defaults below apply.
Leave out what you don't change; unknown or mistyped settings are an error, not ignored. The defaults:

""" + EXAMPLE_CONFIG + """

  files.include   glob patterns, relative to the current directory, of the env files has, list and redact read
                  by default (a path like "config/.env*" works). --file is never filtered.
  files.exclude   file-name patterns dropped from those.
  redact.names    glob patterns (case-insensitive) on the whole variable name: a variable whose name matches
                  has its value redacted. KEY and PASS are spelled as whole words so MONKEY or
                  KEYBOARD_LAYOUT don't match; add e.g. "*SALT*", "*WEBHOOK*" or "*_URL" as needed.
  redact.excludeNames  names that match `names` but hold config, not secrets (TOKEN_TTL=3600, or the path
                  in GOOGLE_APPLICATION_CREDENTIALS).
  redact.minLength  values shorter than this are not redacted, a floor so that values like 3600 or 8 aren't
                  replaced everywhere; 0 means no minimum.
  redact.urlPasswords  also mask the password of any scheme://user:password@host in the text, whatever
                  variable (if any) it came from: DATABASE_URL=postgres://app:[REDACTED:url-password]@db/main.
                  The rest of the URL stays readable, and a JSON-escaped one (scheme:\\/\\/...) is masked too. A `/`
                  in the password, or an `@` in the user, must be percent-encoded.

For tooling:
  secrets redact [--file PATH]...   reads text on stdin and writes it with secret values replaced by
                                    [REDACTED:NAME]. The values are those of variables whose name matches
                                    redact.names (and not redact.excludeNames) and that are at least
                                    redact.minLength long, from the environment, the default env files of
                                    the current directory and of its parents up to the git root, --file and
                                    the files in $SECRETS_REDACT_FILES (a `:`-separated list). A value in an
                                    env file that is only a reference (${OTHER}, or $OTHER with a name in
                                    capitals, digits and `_`) is skipped, and $SECRETS_CONFIG and
                                    $SECRETS_REDACT_FILES are never secrets. Commented-out assignments
                                    (`# NAME=value`) and those a later one overrides count too; a commented-out
                                    one is read from its own line only (a multi-line value by its first line,
                                    a PEM block not at all: that is its -----BEGIN marker), and is skipped
                                    when it is a placeholder: <...>, your-... or your_... (any case), a run
                                    of x, *, . or - only (xxxx, ***, ...), or changeme. A value is
                                    also redacted as written in the file (`\\n` escapes), and so is each line
                                    of a multi-line one that looks like key material (16+ characters, no
                                    spaces, not a -----BEGIN/-----END line) and, in a line with spaces, each
                                    word of 32+ characters that isn't a URL, an email address or a marker
                                    (a JSON credential's "private_key": "..."). Letters-only or digits-only
                                    values under 16 characters ("postgres", "123456") are only redacted right
                                    after their own variable name (`POSTGRES_PASSWORD=...`), since they are
                                    ordinary words or numbers elsewhere. URL passwords become
                                    [REDACTED:url-password]. Best effort within bounds, so it stays fast: it
                                    reads at most 50 env files and 4 MiB of them in all, skipping a file over 1 MiB and
                                    the files past that budget, and looks for at most 10,000 distinct values,
                                    the first found: the environment's, then those of $SECRETS_REDACT_FILES and
                                    --file, then those of the env files of the directories. The Claude
                                    Code plugin redact-secrets runs it on every tool result and background
                                    notification.
"""


class SecretsError(Exception):
    pass


def closing_quote(text, quote):
    i = 0
    while i < len(text):
        if quote == '"' and text[i] == "\\":
            i += 2
            continue
        if text[i] == quote:
            return i
        i += 1
    return None


def unescape(value):
    return re.sub(r'\\(["\\nrt])', lambda m: {"n": "\n", "r": "\r", "t": "\t"}.get(m.group(1), m.group(1)), value)


def parse_value(rest, lines, index, pem_end):
    """Returns the value, the text it was written as (differs for escaped double-quoted values) and the index of the line after it.

    `rest` is everything after `=`, blanks included: a `#` after them starts a comment (`NAME= # note` is empty)."""
    stripped = rest.lstrip()
    quote = stripped[:1]
    if quote not in ('"', "'"):
        if stripped.startswith("-----BEGIN") and "-----END" not in stripped:
            # An unquoted PEM block spans lines; without this its base64 lines parse as variables.
            end = pem_end(index)
            if end is not None:
                value = "\n".join([stripped, *lines[index:end + 1]])
                return value, value, end + 1
        comment = COMMENT.search(rest)
        value = (rest[:comment.start()] if comment else rest).strip()
        return value, value, index
    chunk = stripped[1:]
    start = index
    parts = []
    while True:
        end = closing_quote(chunk, quote)
        if end is not None:
            parts.append(chunk[:end])
            raw = "\n".join(parts)
            return (unescape(raw) if quote == '"' else raw), raw, index
        parts.append(chunk)
        if index >= len(lines):
            # Unterminated: the value is the rest of its own line, so the variables below it still parse.
            return stripped[1:], stripped[1:], start
        chunk = lines[index]
        index += 1


# Names are capped at 63 characters: the base64 lines of a key file (64-70) that end in `=` padding aren't variables.
ASSIGNMENT = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]{0,62})\s*=(.*)$")


def is_key_line(name, rest):
    """A base64 key line (a Fernet or WireGuard key) reads as `NAME=` or `NAME==`. Random base64 mixes upper and
    lower case; the name of a variable that's only declared (`FOO=`, `foo_bar=`) doesn't."""
    return bool(PADDING.fullmatch(rest.lstrip())) and name not in (name.upper(), name.lower())


def parse_env_text(text, assignments=None):
    """`assignments`, when given, receives the (name, value, text it was written as) of every assignment, also of
    those a later one overrides and of the commented-out ones, for redaction."""
    values = {}
    lines = text.splitlines()
    ends = []

    def pem_end(index):
        """The `-----END` line of a PEM block whose body starts at `index`, or None: none comes within PEM_MAX_LINES
        before an assignment. Found for every line in one pass, so a file of BEGIN lines stays linear."""
        if not ends:
            ends.append(None)
            for line in reversed(lines):
                ends.append(None if ENV_LINE.match(line) else len(lines) - len(ends) if "-----END" in line else ends[-1])
            ends.reverse()
        end = ends[index]
        return end if end is not None and end < index + PEM_MAX_LINES else None

    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if line.lstrip().startswith("-----BEGIN") and "-----END" not in line:
            # A key file's block: its last base64 line, when short and `=`-padded, would parse as a name.
            end = pem_end(i)
            if end is not None:
                i = end + 1
            continue
        match = ASSIGNMENT.match(line)
        if match and not is_key_line(*match.groups()):
            name = match.group(1)
            values[name], raw, i = parse_value(match.group(2), lines, i, pem_end)
            if assignments is not None:
                assignments.append((name, values[name], raw))
        elif assignments is not None and (match := COMMENTED_ASSIGNMENT.match(line)):
            # From its own line only, with no look-ahead: an open quote in a comment would take the live lines
            # below into its value, and a commented BEGIN line per line would each copy up to PEM_MAX_LINES.
            value, raw, _ = parse_value(match.group(2), (), 0, lambda _: None)
            if not PLACEHOLDER.fullmatch(value) and not PEM_MARKER.fullmatch(value):
                assignments.append((match.group(1), value, raw))
    return values


def read_capped(path, limit):
    """At most `limit` + 1 bytes of the file: reading one more than fits, rather than trusting a size, also bounds a
    device or a FIFO, which have none (/dev/zero never ends)."""
    try:
        # Non-blocking only to open it: a FIFO without a writer would wait for one forever.
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        os.set_blocking(fd, True)
        with open(fd, "rb") as f:
            return f.read(limit + 1)
    except FileNotFoundError:
        raise SecretsError(f"file not found: {path}")
    except OSError as e:
        raise SecretsError(f"can't read {path}: {e.strerror}")


def parse_env_bytes(data, assignments=None):
    # utf-8-sig: a BOM would otherwise end up in the first variable's name.
    return parse_env_text(data.decode("utf-8-sig", errors="replace"), assignments)


def read_env_file(path):
    data = read_capped(path, MAX_FILE_BYTES)
    if len(data) > MAX_FILE_BYTES:
        raise SecretsError(f"file too large to read as an env file (over {MAX_FILE_BYTES >> 20} MiB): {path}")
    return parse_env_bytes(data)


def merge_config(defaults, user, path, prefix=""):
    if not isinstance(user, dict):
        raise SecretsError(f"{path}: {prefix.rstrip('.') or 'the config'} must be an object")
    merged = dict(defaults)
    for key, value in user.items():
        if key not in defaults:
            raise SecretsError(f"{path}: unknown setting {prefix}{key}")
        default = defaults[key]
        if isinstance(default, dict):
            merged[key] = merge_config(default, value, path, f"{prefix}{key}.")
        elif isinstance(default, bool):
            if not isinstance(value, bool):
                raise SecretsError(f"{path}: {prefix}{key} must be true or false")
            merged[key] = value
        elif isinstance(default, list):
            if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
                raise SecretsError(f"{path}: {prefix}{key} must be a list of strings")
            merged[key] = value
        else:
            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
                raise SecretsError(f"{path}: {prefix}{key} must be a non-negative integer")
            merged[key] = value
    return merged


@functools.lru_cache(maxsize=None)
def load_config():
    explicit = os.environ.get(CONFIG_VAR)
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    path = explicit or os.path.join(base, "secrets-cli", "config.json")
    try:
        with open(path, encoding="utf-8") as f:
            user = json.load(f)
    except FileNotFoundError:
        if explicit:
            raise SecretsError(f"{CONFIG_VAR} points to a file that doesn't exist: {path}")
        return DEFAULT_CONFIG
    except (OSError, ValueError) as e:
        raise SecretsError(f"can't read config {path}: {getattr(e, 'strerror', None) or e}")
    return merge_config(DEFAULT_CONFIG, user, path)


def common_env_files(base=".", limit=MAX_ENV_FILES):
    files = load_config()["files"]
    patterns = files["include"] if base == "." else [os.path.join(glob.escape(base), p) for p in files["include"]]
    found = sorted({path for pattern in patterns for path in glob.glob(pattern)})
    chosen = []
    for path in found:
        if len(chosen) == limit:
            break  # a directory of thousands of .env.N files isn't stat'ed and opened one by one
        if os.path.isfile(path) and not any(fnmatch.fnmatch(os.path.basename(path), x) for x in files["exclude"]):
            chosen.append(path)
    return chosen


def redact_env_files():
    """The env files of the working directory and of its parents up to the git root, so `cat ../.env` from a subdirectory is covered too."""
    cwd = os.getcwd()
    dirs = [cwd]
    current = cwd
    while not os.path.exists(os.path.join(current, ".git")):
        parent = os.path.dirname(current)
        if parent == current:
            dirs = [cwd]  # no repository: only the working directory
            break
        current = parent
        dirs.append(current)
    files = common_env_files()
    for directory in dirs[1:]:
        if len(files) < MAX_ENV_FILES:
            files += common_env_files(directory, MAX_ENV_FILES - len(files))
    return files


def load_sources(args):
    """The (label, values, error) of each source chosen by --env/--file, or by default; `values` is None when unreadable."""
    files = args.file or ([] if args.env else common_env_files())
    sources = []
    if args.env or not args.file:
        sources.append(("env", dict(os.environ), None))
    for path in files:
        try:
            sources.append((path, read_env_file(path), None))
        except SecretsError as e:
            sources.append((path, None, str(e)))
    return sources, not files and not args.env


def no_files_note():
    return f"No env files in the current directory (looked for {', '.join(load_config()['files']['include'])})"


def sections(sources, no_files, describe):
    blocks = []
    for label, values, error in sources:
        body = [f"({error})"] if error else describe(values)
        blocks.append("\n".join([f"## {label}", *body]))
    if no_files:
        blocks.append(f"_{no_files_note()}._")
    print("\n\n".join(blocks))


def cmd_has(args):
    sources, no_files = load_sources(args)
    readable = [(label, values) for label, values, _ in sources if values is not None]
    checked = ", ".join(label for label, _, _ in sources)
    lines = []
    ok = True
    for name in args.names:
        where = [label for label, values in readable if values.get(name)]
        if where:
            lines.append(f"{name}: set in {', '.join(where)}")
            continue
        ok = False
        empty = [label for label, values in readable if name in values]
        lines.append(f"{name}: not set (checked {checked}{'; empty in ' + ', '.join(empty) if empty else ''})")
    lines += [f"({error})" for _, _, error in sources if error]
    if no_files:
        lines.append(f"({no_files_note()})")
    print("\n".join(lines))
    return 0 if ok and not any(error for _, _, error in sources) else 1


def cmd_list(args):
    sources, no_files = load_sources(args)
    sections(sources, no_files, lambda values: [f"- {name}" for name in values] or ["(no variables)"])
    return 1 if any(error for _, _, error in sources) else 0


def cmd_get(args):
    sources, _ = load_sources(args)
    for _, _, error in sources:
        if error:
            raise SecretsError(error)
    labels = ", ".join(label for label, _, _ in sources)
    found = {label: values[args.name] for label, values, _ in sources if values.get(args.name)}
    if not found:
        state = "empty" if any(args.name in values for _, values, _ in sources) else "not set"
        raise SecretsError(f"{args.name} is {state} in {labels}")
    if len(set(found.values())) > 1:
        raise SecretsError(f"{args.name} has different values in {', '.join(found)}; choose one with --env or --file PATH")
    sys.stdout.write(next(iter(found.values())) + ("\n" if sys.stdout.isatty() else ""))
    return 0


def key_material(line):
    if KEY_BODY_LINE.fullmatch(line):
        return [line]
    words = (word.strip("\"',") for word in line.split())
    return [w for w in words if len(w) >= KEY_WORD_MIN_LENGTH and not w.startswith("-----") and "://" not in w and "@" not in w]


def secret_values(files):
    """The (name, value, is_weak) to look for in text, from the environment and the env files."""
    redact = load_config()["redact"]
    min_length = max(redact["minLength"], 1)
    names = [p.upper() for p in redact["names"]]
    excluded = [p.upper() for p in redact["excludeNames"]]

    def is_secret(name):
        if name in (CONFIG_VAR, REDACT_FILES_VAR):
            return False  # this CLI's own settings: paths, which `*SECRET*` would otherwise hide from every command line
        upper = name.upper()
        return any(fnmatch.fnmatchcase(upper, p) for p in names) and not any(fnmatch.fnmatchcase(upper, p) for p in excluded)

    # The environment holds expanded values, so a `$` there is part of the value, never a reference.
    sources = [([(name, value, value) for name, value in os.environ.items()], False)]
    budget = MAX_REDACT_BYTES
    for path in files:
        limit = min(MAX_FILE_BYTES, budget)
        if limit <= 0:
            break
        try:
            data = read_capped(path, limit)
        except SecretsError:
            continue  # redaction is best effort: a file that's absent here has nothing to hide
        budget -= len(data)
        if len(data) > limit:
            continue
        assignments = []
        parse_env_bytes(data, assignments)
        sources.append((assignments, True))
    found = {}
    for assignments, is_file in sources:
        for name, value, raw in assignments:
            if not is_secret(name) or len(value) < min_length or (is_file and REFERENCE.fullmatch(value)):
                continue
            # The value as written too (`cat .env` shows the escapes), and the key material of a multi-line one
            # (a numbered listing of the file, or a grep, splits it).
            variants = [value, raw] if raw != value else [value]
            lines = [line.strip() for v in variants if "\n" in v for line in v.split("\n")]
            variants += [part for line in lines for part in key_material(line)]
            for variant in variants:
                if len(variant) < min_length:
                    continue
                is_weak = bool(WEAK_VALUE.fullmatch(variant)) and len(variant) < WEAK_MAX_LENGTH
                found.setdefault((variant, name if is_weak else None), (name, variant, is_weak))
                if len(found) == MAX_SEARCH_VALUES:
                    return list(found.values())
    return list(found.values())


def weak_spans(text, secrets):
    """The weak values written right after their own name: `NAME`, an optional quote, `=` or `:`, an optional quote.

    One pass for all of them, from each `=` or `:` to the word after it, then back to the name before it: a regex
    per name took seconds to compile for a file of many such names, and each one scanned the whole text."""
    by_value = {}
    for name, value, _ in secrets:
        by_value.setdefault(value, {}).setdefault(len(name), set()).add(name)
    spans = []
    for m in WEAK_CONTEXT.finditer(text):
        names = by_value.get(m.group(1))
        if not names:
            continue
        end = m.start()
        while end > 0 and text[end - 1].isspace():
            end -= 1
        if end > 0 and text[end - 1] in "\"'":
            end -= 1
        for length, candidates in names.items():
            start = end - length
            if start >= 0 and (start == 0 or not WORD_CHAR.match(text[start - 1])) and text[start:end] in candidates:
                spans.append((m.start(1), m.end(1), text[start:end], 0))
    return spans


def redaction_spans(text, secrets, url_passwords):
    """(start, end, label, priority) of everything to replace, found on the original text so that overlaps resolve at once."""
    spans = weak_spans(text, [secret for secret in secrets if secret[2]])
    for name, value, is_weak in secrets:
        if is_weak:
            continue
        i = text.find(value)
        while i != -1:
            spans.append((i, i + len(value), name, 0))
            i = text.find(value, i + 1)
    if url_passwords:
        spans += [(m.start(1), m.end(1), "url-password", 1) for m in URL_PASSWORD.finditer(text)]
    return spans


def cmd_redact(args):
    extra = [p for p in os.environ.get(REDACT_FILES_VAR, "").split(os.pathsep) if p]
    # The files the person named first: a repository's own files can use up the bounds, and shouldn't cost them theirs.
    secrets = secret_values([*extra, *args.file, *redact_env_files()])
    text = sys.stdin.buffer.read().decode("utf-8", errors="replace")
    spans = redaction_spans(text, secrets, load_config()["redact"]["urlPasswords"])
    # Overlapping matches (a value inside another, two values sharing characters) become one span, labelled
    # by the one that starts first, a named secret before a URL password; the longer one first on a tie.
    spans.sort(key=lambda span: (span[0], span[3], span[0] - span[1]))
    out, pos, merged = [], 0, []
    for start, end, label, _ in spans:
        if merged and start < merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end, label])
    for start, end, label in merged:
        out += [text[pos:start], f"[REDACTED:{label}]"]
        pos = end
    out.append(text[pos:])
    sys.stdout.buffer.write("".join(out).encode("utf-8"))
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog="secrets",
        description=DESCRIPTION,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True, metavar="{has,list,get,redact}")

    def add_sources(p):
        p.add_argument("--env", action="store_true", help="only the current environment")
        p.add_argument("--file", action="append", default=[], metavar="PATH", help="only this env file (repeatable); without --env/--file: the environment and the env files of ./")

    has = sub.add_parser("has", help="is each NAME set (non-empty)? never prints values")
    has.add_argument("names", nargs="+", metavar="NAME")
    add_sources(has)
    has.set_defaults(run=cmd_has)

    lst = sub.add_parser("list", help="names defined, no values")
    add_sources(lst)
    lst.set_defaults(run=cmd_list)

    get = sub.add_parser("get", help="print a value, for piping into another command only")
    get.add_argument("name", metavar="NAME")
    add_sources(get)
    get.set_defaults(run=cmd_get)

    redact = sub.add_parser("redact", help="replace secret values in stdin with [REDACTED:NAME]")
    redact.add_argument("--file", action="append", default=[], metavar="PATH", help="also redact this file's secrets (repeatable)")
    redact.set_defaults(run=cmd_redact)
    return parser


def main(argv):
    args = build_parser().parse_args(argv)
    try:
        return args.run(args)
    except SecretsError as e:
        print(f"secrets: {e}", file=sys.stderr)
        return 1
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
